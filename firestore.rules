rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Strict user data isolation: Only authenticated users can access their own interactions & biases
    match /users/{userId}/interactions/{interactionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /biases/{biasId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Strict user data isolation: Action boards and extracted atomic tasks
    match /users/{userId}/action_boards/{boardId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
